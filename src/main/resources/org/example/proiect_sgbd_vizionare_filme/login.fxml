<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #141414;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.proiect_sgbd_vizionare_filme.controllers.LoginController">
   <children>
      <VBox alignment="CENTER" maxWidth="400.0" prefHeight="300.0" spacing="20.0" style="-fx-background-color: #2b2b2b; -fx-background-radius: 10; -fx-padding: 30;">
         <children>
            <Label text="Select Profile" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <ComboBox fx:id="userComboBox" maxWidth="1.7976931348623157E308" promptText="Choose a user..." style="-fx-font-size: 14px;" />
            <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" style="-fx-background-color: #E50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="Login" />
         </children>
         <StackPane.margin>
            <Insets />
         </StackPane.margin>
      </VBox>
   </children>
</StackPane>