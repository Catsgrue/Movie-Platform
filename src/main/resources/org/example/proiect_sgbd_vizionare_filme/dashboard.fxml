<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<BorderPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #141414;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.proiect_sgbd_vizionare_filme.controllers.DashBoardController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: #000000; -fx-padding: 10 20 10 20;" BorderPane.alignment="CENTER">
         <children>
            <Label text="PLATFORM" textFill="#e50914">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <TextField fx:id="searchField" onKeyReleased="#getSearchedMovie" prefWidth="250.0" promptText="Search for a movie..." style="-fx-background-color: #333333; -fx-text-fill: white;" />
            <ComboBox fx:id="genreFilterComboBox" onAction="#getMoviesByGenre" prefWidth="150.0" promptText="All genres" />

            <Button fx:id="recommendationsButton" mnemonicParsing="false" onAction="#handleRecommendations" style="-fx-background-color: #2b2b2b; -fx-text-fill: #ffd700; -fx-border-color: #ffd700; -fx-border-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;" text="★ Get Recommendations" />

            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="userNameLabel" text="Username" textFill="WHITE">
               <font><Font size="14.0" /></font>
            </Label>
         </children>
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" style="-fx-background: #141414; -fx-border-color: transparent;" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="15.0" style="-fx-padding: 20;">
               <children>
                  <Label fx:id="recommendationMessageLabel" text="Here are your top recommendations based on your profile similarity:" textFill="#ffd700" visible="false" managed="false">
                     <font><Font name="System Bold" size="18.0" /></font>
                  </Label>

                  <VBox fx:id="historySection" spacing="10.0" visible="false" managed="false">
                     <children>
                        <Label text="Continue Watching" textFill="WHITE">
                           <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="NEVER">
                           <content>
                              <HBox fx:id="historyContainer" spacing="15.0" />
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>

                  <FlowPane fx:id="moviesContainer" hgap="20.0" vgap="20.0" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
