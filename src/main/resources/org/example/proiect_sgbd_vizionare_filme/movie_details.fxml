<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" prefHeight="900.0" prefWidth="1000.0" style="-fx-background: #141414; -fx-background-color: #141414;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.proiect_sgbd_vizionare_filme.controllers.MovieDetailsController">
    <content>
        <VBox spacing="30.0" style="-fx-padding: 20 40 40 40; -fx-background-color: #141414;">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Button fx:id="goBackButton" mnemonicParsing="false" onAction="#handleGoBack" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5; -fx-cursor: hand;" text="← Go Back">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="usernameLabel" text="Username" textFill="WHITE">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <StackPane prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: #444444; -fx-background-radius: 15;">
                            <children>
                                <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="WHITE" scaleX="0.9" scaleY="0.9" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>

                <HBox spacing="30.0">
                    <children>
                        <ImageView fx:id="moviePoster" fitHeight="400.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="true" />

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="titleLabel" text="Movie Title" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="36.0" />
                                    </font>
                                </Label>

                                <HBox prefWidth="594.0" spacing="10.0">
                                    <Label fx:id="genreLabel" text="Genre" textFill="#aaaaaa">
                                        <font>
                                            <Font size="18.0" />
                                        </font>
                                    </Label>
                                </HBox>
                                 <Label fx:id="yearLabel" text="Year" textFill="#aaaaaa">
                                     <font>
                                         <Font size="18.0" />
                                     </font>
                                 </Label>

                                <Label fx:id="ratingLabel" text="⭐ Average Rating: 0.00" textFill="#ffd700">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Label fx:id="descriptionLabel" text="Movie description will appear here..." textFill="WHITE" wrapText="true">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>

                                <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                                    <Label text="Cast" textFill="WHITE">
                                        <font>
                                            <Font name="System Bold" size="20.0" />
                                        </font>
                                    </Label>
                                    <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="NEVER">
                                        <content>
                                            <HBox fx:id="castContainer" spacing="15.0">
                                            </HBox>
                                        </content>
                                    </ScrollPane>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <StackPane prefHeight="400.0" style="-fx-background-color: #000000; -fx-border-color: #333333; -fx-border-width: 2;">
                    <children>
                        <VBox alignment="CENTER" spacing="20.0">
                            <HBox alignment="CENTER" spacing="20.0">
                                <Label text="Choose version:" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="formatComboBox" prefWidth="120.0" promptText="Format" />
                                <ComboBox fx:id="languageComboBox" prefWidth="120.0" promptText="Language" />
                            </HBox>

                            <Button fx:id="watchButton" mnemonicParsing="false" onAction="#handleWatchMovie" style="-fx-background-color: rgba(229, 9, 20, 0.8); -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 15 30 15 30; -fx-cursor: hand;" text="▶ PLAY">
                                <font>
                                    <Font name="System Bold" size="24.0" />
                                </font>
                            </Button>
                        </VBox>
                    </children>
                </StackPane>

                <VBox spacing="15.0" style="-fx-background-color: #222222; -fx-padding: 20; -fx-background-radius: 10;">
                    <children>
                        <Label text="Leave a review" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>

                        <HBox fx:id="starRatingContainer" spacing="5.0">
                            <Label fx:id="star1" onMouseClicked="#handleStarClick" style="-fx-cursor: hand;" text="☆" textFill="#ffd700">
                                <font><Font size="36.0" /></font>
                            </Label>
                            <Label fx:id="star2" onMouseClicked="#handleStarClick" style="-fx-cursor: hand;" text="☆" textFill="#ffd700">
                                <font><Font size="36.0" /></font>
                            </Label>
                            <Label fx:id="star3" onMouseClicked="#handleStarClick" style="-fx-cursor: hand;" text="☆" textFill="#ffd700">
                                <font><Font size="36.0" /></font>
                            </Label>
                            <Label fx:id="star4" onMouseClicked="#handleStarClick" style="-fx-cursor: hand;" text="☆" textFill="#ffd700">
                                <font><Font size="36.0" /></font>
                            </Label>
                            <Label fx:id="star5" onMouseClicked="#handleStarClick" style="-fx-cursor: hand;" text="☆" textFill="#ffd700">
                                <font><Font size="36.0" /></font>
                            </Label>
                        </HBox>

                        <ComboBox fx:id="predefinedOptionComboBox" prefWidth="250.0" promptText="Choose a quick tag (optional)" />
                        <TextArea fx:id="commentArea" prefHeight="100.0" promptText="Write your thoughts about the movie..." wrapText="true" />
                        <Button fx:id="submitReviewButton" mnemonicParsing="false" onAction="#handleSubmitReview" style="-fx-background-color: #E50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Submit Review" />
                    </children>
                </VBox>

                <VBox fx:id="reviewsListContainer" spacing="15.0">
                    <Label text="Recent Reviews" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
